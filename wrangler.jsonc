{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "texasbusinessworth",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-26",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "texas-business-worth",
      "database_id": "48f273b9-28d4-47c4-ba05-646843beab68",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "ESTIMATE_RATE_LIMITER",
      "namespace_id": "71001",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "LEAD_RATE_LIMITER",
      "namespace_id": "71002",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "vars": {
    "MODEL_VERSION": "TBW-1.0",
    "BENCHMARK_VERSION": "2026-Q3-seed",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEfscj2KB5MtmON6"
  },
  "triggers": {
    "crons": ["15 8 * * 1"]
  },
  "observability": {
    "enabled": true
  }
}
